# Configurações de desenvolvimento
# Copie este arquivo para .env.development

# URL da API para o proxy do Vite. Use o nome do serviço de nginx da API do
# projeto, na rede Docker criada pelo compose de desenvolvimento da API.
VITE_API_PROXY_TARGET=http://minha-api-nginx:80

# Nome da aplicação
VITE_APP_NAME="React Client"

# Base do axios/httpClient. Mantenha /api quando houver proxy reverso.
VITE_API_BASE_URL=/api
APP_SOURCE_DIR=src/app

# Redes e identidade do container (compose)
APP_NETWORK=app-network
API_NETWORK=api_minha-rede
CLIENT_CONTAINER_NAME=react-client-dev
CLIENT_DEV_PORT=5173
