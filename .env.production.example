# Central Alia admin — generic Swarm/Traefik production.
# For the Alia Brasil VPS Docker Compose deployment, use .env.vps.example.

CLIENT_IMAGE=registry.example.com/alia/client
CLIENT_IMAGE_TAG=latest
CLIENT_HOST=admin.example.com
NGINX_SERVER_NAME=admin.example.com

# The frontend proxies /api and /sanctum through the private Docker network.
# With `docker stack deploy -c ... alia-api`, the API service is
# `alia-api_nginx`. Use the actual service DNS name if your stack name differs.
API_BACKEND=http://alia-api_nginx:80
API_NETWORK=alia-internal
APP_NETWORK=Diatech

VITE_API_BASE_URL=/api
VITE_APP_NAME=Alia
APP_SOURCE_DIR=src/app

TRAEFIK_ROUTER=alia-admin
TRAEFIK_NETWORK=Diatech
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencryptresolver
