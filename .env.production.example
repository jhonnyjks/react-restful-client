# Produção genérica em Swarm/Traefik (docker-compose.yml).
# Para deploy em Docker Compose numa VPS, use .env.vps.example.

CLIENT_IMAGE=registry.exemplo.com/meu-projeto/client
CLIENT_IMAGE_TAG=latest
CLIENT_HOST=admin.exemplo.com
NGINX_SERVER_NAME=admin.exemplo.com

# O frontend faz proxy de /api e /sanctum pela rede Docker privada.
# Com `docker stack deploy -c ... minha-api`, o serviço da API é
# `minha-api_nginx`. Use o nome DNS real se o nome da stack for outro.
API_BACKEND=http://minha-api_nginx:80
API_NETWORK=rede-interna
APP_NETWORK=rede-do-proxy

VITE_API_BASE_URL=/api
VITE_APP_NAME=Meu Admin
VITE_SHOW_MAIN_FOOTER=true
APP_SOURCE_DIR=src/app

TRAEFIK_ROUTER=meu-admin
TRAEFIK_NETWORK=rede-do-proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencryptresolver
