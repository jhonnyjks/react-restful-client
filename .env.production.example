# Configuração do ambiente de PRODUÇÃO
# Copie este arquivo para .env.production e ajuste conforme necessário

# URL do backend da API
# Exemplos:
# - http://alia-nginx:80 (se estiver na mesma rede Docker)
# - http://host.docker.internal:8080 (se a API estiver no host)
# - http://api.example.com (URL externa)
API_BACKEND=http://172.27.0.1:8080

# Porta do cliente
CLIENT_PORT=3000

# Nome da aplicação (exibido na página de login e página principal)
VITE_APP_NAME="Alia"