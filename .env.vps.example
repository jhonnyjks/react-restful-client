# Deploy em Docker Compose numa VPS (docker-compose.vps.yml).
# Copie para .env.vps na própria VPS. Os valores reais do projeto ficam no
# repositório do app (src/app), não aqui.

# Identidade da stack: sem isso o compose não sobe, para não herdar o nome de
# outro projeto que já usou esta base.
CLIENT_STACK_NAME=meu-admin
CLIENT_IMAGE=meu-admin
CLIENT_IMAGE_TAG=local
CLIENT_CONTAINER_NAME=meu-admin

NGINX_SERVER_NAME=admin.exemplo.com
# Alias do nginx da API na rede Docker privada.
API_BACKEND=http://minha-api-internal:80
PUBLIC_NETWORK=rede-publica
APPLICATION_NETWORK=rede-interna

VITE_API_BASE_URL=/api
VITE_APP_NAME=Meu Admin
VITE_SHOW_MAIN_FOOTER=true
APP_SOURCE_DIR=src/app
