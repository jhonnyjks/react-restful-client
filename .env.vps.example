# Alia admin — Docker Compose on the Alia Brasil VPS.
# Copy to .env.vps only on the VPS.

NGINX_SERVER_NAME=g.aliabrasil.com
# API Nginx alias on the private shared Docker network.
API_BACKEND=http://alia-api-internal:80
PUBLIC_NETWORK=aliabrasil
APPLICATION_NETWORK=alia-internal

VITE_API_BASE_URL=/api
VITE_APP_NAME=Alia
# Hide the legacy AdminLTE fixed footer (blocks bottom actions like Salvar).
VITE_SHOW_MAIN_FOOTER=false
APP_SOURCE_DIR=src/app
